{{!
    @template local_campusupdates/course_card

    Catalogue card for a demo course.
}}
<article class="local-campusupdates__course-card">
    <a class="local-campusupdates__thumb" href="{{url}}">
        <img src="{{thumb}}" alt="" />
    </a>
    <div class="local-campusupdates__course-copy">
        <div class="local-campusupdates__card-meta">
            <span class="local-campusupdates__tag">{{tag}}</span>
            <span class="local-campusupdates__level">{{level}}</span>
        </div>
        <h3 class="local-campusupdates__card-title">{{title}}</h3>
        <p class="local-campusupdates__card-summary">{{summary}}</p>
        <p class="local-campusupdates__duration">{{duration}}</p>
        <a class="btn btn-primary" href="{{url}}">{{openlabel}}</a>
    </div>
</article>

{{!
    @template local_campusupdates/chapter

    Chapter page: pick a topic, then Simple or Advanced.
}}
<article class="cu-chapter" data-chapter="{{id}}">
    <p class="local-campusupdates__back">
        <a href="{{backurl}}">← {{backlabel}}</a>
    </p>
    <p class="cu-chapter__kicker">{{coursetitle}} · practice lab</p>
    <h2>{{title}}</h2>
    <p class="cu-chapter__sub">{{subtitle}}</p>
    <p>{{summary}}</p>

    {{#ready}}
        {{#hastopics}}
            {{#topics}}
                <section class="cu-topic">
                    <h3>{{title}}</h3>
                    <p>{{summary}}</p>
                    {{#hassyllabus}}
                        <p class="cu-topic__syllabus">From the syllabus: {{syllabus}}</p>
                    {{/hassyllabus}}
                    <p class="cu-topic__mode-label">{{modelabel}}</p>
                    <div class="cu-mode-pick">
                        <a class="cu-mode-pick__card" href="{{simpleurl}}">
                            <strong>{{simplelabel}}</strong>
                            <span>{{simplehelp}}</span>
                            <em>Start</em>
                        </a>
                        <a class="cu-mode-pick__card cu-mode-pick__card--adv" href="{{advancedurl}}">
                            <strong>{{advancedlabel}}</strong>
                            <span>{{advancedhelp}}</span>
                            <em>Start</em>
                        </a>
                    </div>
                </section>
            {{/topics}}
        {{/hastopics}}
    {{/ready}}
    {{^ready}}
        <p class="cu-chapter__soon">{{comingsoon}}</p>
    {{/ready}}
</article>

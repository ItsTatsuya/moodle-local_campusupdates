{{!
    @template local_campusupdates/workshop

    Four-screen profit landscape workshop.
}}
<div class="cu-ws" id="cu-workshop" data-back="{{backurl}}">
    <p class="local-campusupdates__back">
        <a href="{{backurl}}">← {{backlabel}}</a>
    </p>
    <header class="cu-ws__head">
        <div>
            <p class="cu-ws__kicker">Workshop</p>
            <h2>{{title}}</h2>
            <p class="cu-ws__lead">Enter a few numbers about a shop. Profit becomes a hill. You walk uphill to the mix that makes the most money.</p>
        </div>
        <div class="cu-ws__profit" id="ws-profit-chip" aria-live="polite">Profit today · ₹0</div>
    </header>

    <nav class="cu-ws__steps" aria-label="Workshop screens">
        <button type="button" class="is-on" data-ws-screen="a">1 · Enter the business<span>table → picture</span></button>
        <button type="button" data-ws-screen="b">2 · Hold one still<span>see one slope</span></button>
        <button type="button" data-ws-screen="c">3 · Walk uphill<span>sliders + solve</span></button>
        <button type="button" data-ws-screen="d">4 · Take the answer<span>report + export</span></button>
    </nav>

    <p class="cu-ws__warn" id="ws-warn" hidden></p>

    <section class="cu-ws__screen is-on" data-screen="a">
        <p class="cu-ws__hint">Type the shop’s numbers. The picture is profit — the dark pin is where the shop is today, sitting below the top of the hill.</p>
        <div class="cu-ws__toolbar">
            <span id="ws-model-name">Bakery — March actuals</span>
            <button type="button" class="btn btn-primary btn-sm" id="ws-plot">Plot</button>
            <button type="button" class="btn btn-secondary btn-sm" id="ws-reset-a">Reset</button>
            <button type="button" class="btn btn-secondary btn-sm" id="ws-sample">Load sample</button>
        </div>
        <div class="cu-ws__split">
            <form class="cu-ws__form" id="ws-form" autocomplete="off">
                <fieldset>
                    <legend>Puffs</legend>
                    <label>Starting price
                        <input name="price1" type="number" step="0.01" required>
                        <span>Price if you sold almost none</span>
                    </label>
                    <label>Price drop per unit
                        <input name="priceDrop1" type="number" step="0.001" required>
                        <span>How much you must discount to sell one more</span>
                    </label>
                    <label>Cost per unit
                        <input name="cost1" type="number" step="0.01" required>
                        <span>What it costs you to make one</span>
                    </label>
                </fieldset>
                <fieldset>
                    <legend>Teas</legend>
                    <label>Starting price
                        <input name="price2" type="number" step="0.01" required>
                        <span>Price if you sold almost none</span>
                    </label>
                    <label>Price drop per unit
                        <input name="priceDrop2" type="number" step="0.001" required>
                        <span>How much you must discount to sell one more</span>
                    </label>
                    <label>Cost per unit
                        <input name="cost2" type="number" step="0.01" required>
                        <span>What it costs you to make one</span>
                    </label>
                </fieldset>
                <fieldset>
                    <legend>The shop</legend>
                    <label>Congestion cost
                        <input name="congestion" type="number" step="0.001" required>
                        <span>Extra cost when both are busy — shared oven, counter, staff</span>
                    </label>
                    <label>Fixed cost per day
                        <input name="fixedCost" type="number" step="1" required>
                        <span>Rent, power, salaries</span>
                    </label>
                    <label>What we sell today — puffs
                        <input name="currentX" type="number" step="1" required>
                        <span>What the shop actually sells today</span>
                    </label>
                    <label>What we sell today — teas
                        <input name="currentY" type="number" step="1" required>
                        <span>What the shop actually sells today</span>
                    </label>
                </fieldset>
            </form>
            <div class="cu-ws__plot-col">
                <canvas id="ws-canvas-a" width="640" height="360" aria-label="Profit landscape"></canvas>
                <div class="cu-ws__plot-tools">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="ws-toggle-view">Show map from above</button>
                    <p class="cu-ws__here" id="ws-here-a">You are here — 0 puffs, 0 teas</p>
                    <p class="cu-ws__legend"><span class="cu-ws__swatch cu-ws__swatch--you"></span> You are here <span class="cu-ws__swatch cu-ws__swatch--peak"></span> Top of the hill</p>
                </div>
            </div>
        </div>
        <div class="cu-ws__next">
            <button type="button" class="btn btn-primary" data-ws-screen="b">Next · Hold one still</button>
        </div>
    </section>

    <section class="cu-ws__screen" data-screen="b">
        <p class="cu-ws__hint" id="ws-hint-b">Hold teas still. Only puffs can move. The two pictures are the same slice — hill on the left, ordinary curve on the right. The tilted line is the slope, in rupees.</p>
        <div class="cu-ws__toolbar">
            <span id="ws-freeze-label">Freeze an input · teas = 150 · puffs = free</span>
            <button type="button" class="btn btn-secondary btn-sm" id="ws-swap">Swap</button>
        </div>
        <div class="cu-ws__split cu-ws__split--b">
            <div>
                <p class="cu-ws__caption">The hill, sliced</p>
                <canvas id="ws-canvas-b3d" width="640" height="320" aria-label="Landscape with a slice through it"></canvas>
                <label class="cu-ws__slider-label">
                    <span id="ws-freeze-slider-name">Teas — held still</span>
                    <input type="range" id="ws-freeze-slider" min="0" max="500" step="1" value="150">
                    <span id="ws-freeze-value">150 teas</span>
                </label>
            </div>
            <div>
                <p class="cu-ws__caption">That slice as a simple curve</p>
                <canvas id="ws-canvas-b2d" width="640" height="320" aria-label="Profit curve"></canvas>
                <label class="cu-ws__slider-label">
                    <span id="ws-free-slider-name">Puffs — can move</span>
                    <input type="range" id="ws-free-slider" min="0" max="400" step="1" value="200">
                    <span id="ws-free-value">200 puffs</span>
                </label>
            </div>
        </div>
        <p class="cu-ws__slope" id="ws-slope-b">Slope here — each extra puff loses you ₹4.00.</p>
        <div class="cu-ws__next">
            <button type="button" class="btn btn-primary" data-ws-screen="c">Next · Walk uphill</button>
        </div>
    </section>

    <section class="cu-ws__screen" data-screen="c">
        <p class="cu-ws__hint">Now both products can move. Drag the sliders and watch profit. The green arrow points uphill and shrinks as you near the top. Solve jumps there for you.</p>
        <div class="cu-ws__toolbar">
            <span>Optimise</span>
            <button type="button" class="btn btn-primary btn-sm" id="ws-solve">Solve</button>
            <button type="button" class="btn btn-secondary btn-sm" id="ws-arrow">Hide uphill arrow</button>
            <button type="button" class="btn btn-secondary btn-sm" id="ws-reset-c">Reset to actuals</button>
        </div>
        <div class="cu-ws__split cu-ws__split--c">
            <div>
                <p class="cu-ws__caption">Map from above — same-profit rings. Darker is more money.</p>
                <canvas id="ws-canvas-c" width="640" height="400" aria-label="Map of the profit hill from above"></canvas>
                <p class="cu-ws__legend"><span class="cu-ws__swatch cu-ws__swatch--you"></span> You are here <span class="cu-ws__swatch cu-ws__swatch--peak"></span> Top of the hill <span class="cu-ws__swatch cu-ws__swatch--up"></span> Uphill</p>
            </div>
            <div class="cu-ws__levers">
                <label>Puffs per day
                    <input type="range" id="ws-slider-x" min="0" max="400" step="1" value="200">
                    <span id="ws-slider-x-val">200</span>
                </label>
                <label>Teas per day
                    <input type="range" id="ws-slider-y" min="0" max="500" step="1" value="150">
                    <span id="ws-slider-y-val">150</span>
                </label>
                <p class="cu-ws__pair" id="ws-solve-pair" hidden></p>
                <p class="cu-ws__slope cu-ws__slope--sm" id="ws-slope-c"></p>
            </div>
        </div>
        <div class="cu-ws__next">
            <button type="button" class="btn btn-primary" data-ws-screen="d">Next · Take the answer</button>
        </div>
    </section>

    <section class="cu-ws__screen" data-screen="d" id="ws-report">
        <p class="cu-ws__hint">This is the page you keep. One sentence for the shop, then the numbers behind it.</p>
        <div class="cu-ws__toolbar">
            <span>Report</span>
            <button type="button" class="btn btn-primary btn-sm" id="ws-export">Export PDF</button>
            <button type="button" class="btn btn-secondary btn-sm" id="ws-share">Share</button>
        </div>
        <p class="cu-ws__reco" id="ws-reco"></p>
        <div class="cu-ws__cards">
            <article>
                <h3>Best combination</h3>
                <p id="ws-best"></p>
            </article>
            <article>
                <h3>Value of one more unit</h3>
                <p id="ws-unit-value"></p>
                <p class="cu-ws__card-note">At today’s sales, not at the top.</p>
            </article>
            <article>
                <h3>Cost of being off</h3>
                <p id="ws-off"></p>
            </article>
            <article>
                <h3>Break-even ring</h3>
                <p>The dark ring on the map below — profit is zero on that line. Inside it the shop makes money.</p>
            </article>
        </div>
        <canvas id="ws-canvas-d" width="640" height="280" aria-label="Break-even ring"></canvas>
        <details class="cu-ws__working" id="ws-working-wrap">
            <summary>Working shown</summary>
            <pre id="ws-working"></pre>
        </details>
    </section>
    <script type="application/json" id="ws-sample-json">{{{samplejson}}}</script>
</div>

{{!
    @template local_campusupdates/index_page

    Campus Updates landing page.
}}
<div class="local-campusupdates {{sectionclass}}">
    <header class="local-campusupdates__hero">
        <div class="local-campusupdates__hero-copy">
            <p class="local-campusupdates__kicker">
                <span class="local-campusupdates__badge">{{demobadge}}</span>
            </p>
            <p class="local-campusupdates__subtitle">{{subtitle}}</p>
        </div>
        <p class="local-campusupdates__note">{{placeholdernote}}</p>
    </header>

    <nav class="local-campusupdates__tabs" aria-label="{{#str}} pluginname, local_campusupdates {{/str}}">
        {{#tabs}}
            <a class="local-campusupdates__tab{{#active}} is-active{{/active}} local-campusupdates__tab--{{key}}"
               href="{{url}}"
               {{#active}}aria-current="page"{{/active}}>
                <span class="local-campusupdates__tab-label">{{label}}</span>
                <span class="local-campusupdates__tab-help">{{help}}</span>
                <span class="local-campusupdates__tab-count">{{count}}</span>
            </a>
        {{/tabs}}
    </nav>

    {{#iscourse}}
        {{#hascourselist}}
            <section class="local-campusupdates__courses" aria-label="{{#str}} sectioncourse, local_campusupdates {{/str}}">
                {{#courselist}}
                    {{> local_campusupdates/course_card }}
                {{/courselist}}
            </section>
        {{/hascourselist}}
        {{#hascoursedetail}}
            {{#course}}
                {{> local_campusupdates/course_detail }}
            {{/course}}
        {{/hascoursedetail}}
        {{#haschapter}}
            {{#chapter}}
                {{> local_campusupdates/chapter }}
            {{/chapter}}
        {{/haschapter}}
        {{#hasworkshop}}
            {{#workshop}}
                {{> local_campusupdates/workshop }}
            {{/workshop}}
        {{/hasworkshop}}
    {{/iscourse}}

    {{^iscourse}}
        {{#hasitems}}
            {{#hasfeatured}}
                <section class="local-campusupdates__featured" aria-label="{{#str}} featured, local_campusupdates {{/str}}">
                    {{#featured}}
                        {{> local_campusupdates/feed_card }}
                    {{/featured}}
                </section>
            {{/hasfeatured}}
            {{#hascards}}
                <section class="local-campusupdates__grid" aria-label="{{latestlabel}}">
                    {{#cards}}
                        {{> local_campusupdates/feed_card }}
                    {{/cards}}
                </section>
            {{/hascards}}
        {{/hasitems}}
        {{^hasitems}}
            <div class="alert alert-info local-campusupdates__empty">{{noitems}}</div>
        {{/hasitems}}
    {{/iscourse}}

    <div class="cu-modal" id="cu-modal" hidden>
        <div class="cu-modal__panel" role="dialog" aria-modal="true" aria-labelledby="cu-modal-title">
            <h3 id="cu-modal-title"></h3>
            <p class="cu-modal__lead" id="cu-modal-lead"></p>
            <form id="cu-modal-form">
                <input type="hidden" name="kind" id="cu-modal-kind" value="enquiry" />
                <input type="hidden" name="course" id="cu-modal-course" value="" />
                <label>{{#enquiry}}{{name}}{{/enquiry}}
                    <input type="text" name="name" required />
                </label>
                <label>{{#enquiry}}{{email}}{{/enquiry}}
                    <input type="email" name="email" required />
                </label>
                <label>{{#enquiry}}{{message}}{{/enquiry}}
                    <textarea name="message" rows="4" required></textarea>
                </label>
                <div class="cu-modal__actions">
                    <button type="submit" class="btn btn-primary" id="cu-modal-submit"></button>
                    <button type="button" class="btn btn-secondary" data-cu-close>{{#enquiry}}{{close}}{{/enquiry}}</button>
                </div>
            </form>
            <p class="cu-modal__thanks" id="cu-modal-thanks" hidden></p>
        </div>
    </div>
    <script type="application/json" id="cu-modal-copy">{{{enquiryjson}}}</script>
</div>
